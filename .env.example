# ──────────────────────────────────────────────
# Airflow metadata DB
# ──────────────────────────────────────────────
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# ──────────────────────────────────────────────
# Airflow webserver credentials
# ──────────────────────────────────────────────
AIRFLOW_WWW_USER=airflow
AIRFLOW_WWW_PASSWORD=airflow

# Fernet key — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here

# ──────────────────────────────────────────────
# Warehouse DB
# ──────────────────────────────────────────────
WAREHOUSE_DB_USER=warehouse
WAREHOUSE_DB_PASSWORD=warehouse
WAREHOUSE_DB_NAME=music_features

# ──────────────────────────────────────────────
# Airflow UID
# Linux/Mac: run `echo $UID`; Windows: keep 50000
# ──────────────────────────────────────────────
AIRFLOW_UID=50000

# ──────────────────────────────────────────────
# FMA pipeline config (Airflow Variables, also read here for reference)
# ──────────────────────────────────────────────
FMA_SAMPLE_SIZE=100
FMA_DATA_DIR=/opt/airflow/data/fma
FMA_USE_SYNTHETIC=true
